rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cubes - public read, admin write
    match /cubecon_cubes/{cubeId} {
      allow read: if true;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/cubecon_admins/$(request.auth.uid));
    }

    // Votes - public read/write for voting
    match /cubecon_votes/{voteId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings - public read, admin write
    match /cubecon_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/cubecon_admins/$(request.auth.uid));
    }

    // Admins - admin read, admin write
    match /cubecon_admins/{userId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/cubecon_admins/$(request.auth.uid));
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/cubecon_admins/$(request.auth.uid)).data.role == "admin";
    }
  }
}
